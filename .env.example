# GEMINI_API_KEY: Clave de API de Google Gemini (opcional si se usa otro proveedor de IA)
GEMINI_API_KEY=

# MISTRAL_API_KEY: Clave de API de Mistral AI (soporta modelos de texto y visión como pixtral-12b / mistral-small)
MISTRAL_API_KEY=

# GROQ_API_KEY: Clave de API de Groq Cloud (inferencia ultra-rápida con Llama 3.3 y visión Llama 3.2)
GROQ_API_KEY=

# OPENROUTER_API_KEY: Clave de API de OpenRouter (acceso unificado a Mistral, Claude, Gemini, Llama, etc.)
OPENROUTER_API_KEY=

# AI_PROVIDER: Proveedor prioritario preferido ('mistral' | 'groq' | 'openrouter' | 'gemini' | 'auto').
# Por defecto 'auto' detecta la primera clave configurada en este orden: Mistral -> Groq -> OpenRouter -> Gemini.
AI_PROVIDER=auto

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# CLOUDFLARE_API_TOKEN: Token de API de Cloudflare para despliegue y gestión de recursos (Workers, Pages, DNS, D1/KV).
# Configúralo en el panel de Ajustes / Secretos de AI Studio con el nombre exacto: CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=

# CLOUDFLARE_ACCOUNT_ID: (Opcional) ID de tu cuenta de Cloudflare si gestionas múltiples cuentas.
CLOUDFLARE_ACCOUNT_ID=

