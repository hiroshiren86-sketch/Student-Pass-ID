rules_version = '2';

/**
 * Ronda 40 (07/09/2026) — H-40-1: cláusula update de users/{uid} reescrita con el
 * patrón documentado diff().affectedKeys(). La versión Ronda 33 comparaba campos
 * opcionales por acceso directo (resource.data.linkedTeacherId == null …), y el
 * acceso a una CLAVE AUSENTE errora en el motor de reglas → error == null es falso
 * → se denegaba TODO update del dueño cuando el doc no tenía esas claves (los docs
 * creados por Admin SDK no las traen) → en producción rebota con 403 incluso el
 * vínculo savedSettings de H-38-4 y el propio updateMask de diagnóstico. La matriz
 * en vivo de Ronda 39 interpretó ese 403 como "reglas desplegadas ≠ repo": el
 * despliegue era correcto; el bug estaba en las reglas mismas.
 *
 * diff().affectedKeys() es robusto ante claves ausentes y ante escrituras
 * parciales con máscara (setDoc merge del SDK): permite cualquier write que NO
 * toque role/linkedTeacherId/linkedStudentCode y prohíbe añadirlos, cambiarlos o
 * borrarlos (inmutabilidad más estricta que la R33, que permitía AÑADIR el campo
 * cuando estaba ausente).
 *
 * Historial: Ronda 33 (05/09/2026) — MISIÓN AUTH; sucesora de las reglas
 * endurecidas de Ronda 18.
 *
 * Modelo de autenticación (Ronda 33):
 *  - Firebase Auth (proveedor Email/Password) es la ÚNICA autoridad de credenciales
 *    para Rectoría (role ADMIN) y Docentes (role DOCENTE).
 *  - El rol vive EXCLUSIVAMENTE en users/{uid}.role, escrito al crear la cuenta:
 *    ADMIN por despliegue/consola (la cuenta de Rectoría nace pre-provisionada),
 *    DOCENTE por la propia cuenta nueva en su provisión (el cliente NUNCA elige roles).
 *  - Los espejos de credenciales JAMÁS viajan a Firestore: tempPassword/password/
 *    passwordHash se eliminan de los respaldos (backupAllToFirestore los sanitiza).
 *
 * ⚠ DESPLIEGUE (ver docs/DESPLEGUE_FIREBASE.md):
 *  - Consola de Firebase → Firestore Database → (base "ai-studio-sistemaderegistr-…")
 *    → Reglas → pegar este archivo → Publicar.
 *  - Esta base es NOMBRADA (no la (default)); el despliegue por consola aplica a la
 *    base que esté seleccionada — verificar el selector de base antes de publicar.
 *  - Orden seguro: desplegar primero el código de la app (ya desplegado en este push),
 *    después las reglas.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Rol del solicitante leído de su propio perfil (server-side, no falsificable).
    // Coste: 1 lectura de regla por operación — aceptado por seguridad.
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && myRole() == 'ADMIN';
    }

    // ===== Perfiles de usuario (users/{uid}) =====
    // Ronda 33: el perfil es del dueño. En CREATE el rol nace SOLO como DOCENTE
    // (la cuenta ADMIN la provisiona el despliegue/consola, que pasa por encima de
    // estas reglas vía SDK Admin). Ronda 40 (H-40-1): en UPDATE, rol y vinculación
    // son INMUTABLES para el cliente — verificados con diff().affectedKeys(), que
    // no errora con claves ausentes ni con máscaras de escritura parciales.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Ronda 50 (M3): el perfil puede nacer DOCENTE (M2) O ESTUDIANTE_ACUDIENTE (M3). La
      // escritura la hace el usuario NUEVO con su propio token (instancia secundaria), por
      // eso request.auth.uid == userId. El rol ADMIN nunca nace por regla (la cuenta ADMIN
      // se provisiona por consola/SDK Admin, que pasa por encima de estas reglas).
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && (request.resource.data.role == 'DOCENTE' || request.resource.data.role == 'ESTUDIANTE_ACUDIENTE');
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'linkedTeacherId', 'linkedStudentCode']);
      allow delete: if false;
    }

    // ===== Configuración institucional (doc 'main'; sin secretos — Ronda 16) =====
    // Ronda 58 (F-4): ANTES cualquier sesión AUTENTICADA — incluida la ANÓNIMA que
    // el propio terminal abre con ensureAnonymousAuth() y cuya Web API Key es
    // pública por diseño — podía ESCRIBIR la configuración de TODA la institución:
    // reemplazar cloudflareWorkerUrl de todos los dispositivos (el cliente manda
    // Bearer <AUTH_TOKEN> a esa URL → redirección de credenciales) y envenenar
    // jornada/plantilla/schoolCode. AHORA: lectura para sesiones autenticadas
    // (los terminales hidratan ajustes al arrancar), escritura SOLO ADMIN.
    match /school_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== Datos operativos sensibles: solo Rectoría (ADMIN) =====
    // Estudiantes y docentes los administra Rectoría desde la app. El respaldo
    // nube (backupAllToFirestore) y el espejo de docentes corren bajo su sesión.
    // (Ronda 18 permitía escribir a cualquier sesión; Ronda 33 lo restringe.)
    match /students/{studentId} {
      allow read, write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, write: if isAdmin();
    }

    match /schedule_assignments/{assignmentId} {
      allow read, write: if isAdmin();
    }

    // ===== Registros de asistencia =====
    // Ronda 58 (F-4): este espejo de Firestore NO tiene consumidor crítico (la
    // autoridad de hechos es el Worker/D1; syncAttendanceRecord no tiene llamadores
    // y el respaldo backupAllToFirestore corre bajo la sesión de Rectoría). Antes,
    // cualquier sesión ANÓNIMA podía leer TODA la asistencia del colegio y escribir
    // registros que luego el pull propagaba. Ahora: solo ADMIN.
    match /attendance_records/{recordId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== TODO LO DEMÁS: DENEGADO (política de mínima superficie, Ronda 18) =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
