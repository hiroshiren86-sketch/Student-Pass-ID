rules_version = '2';

/**
 * Ronda 18 (02/09/2026) — Reglas de Firestore ENDURECIDAS con sesión obligatoria.
 *
 * Historia:
 *  - Ronda 9 (agente anterior): `allow read, write: if true` GLOBAL — toda la base
 *    pública en internet. REVERTIDO en Ronda 16.
 *  - Ronda 16: catch-all DENY + 5 colecciones operativas aún abiertas (`if true`)
 *    porque Anonymous NO estaba habilitado y las terminales operaban sin sesión.
 *  - Ronda 18 (HOY): el propietario HABILITÓ Firebase Anonymous (verificado por REST:
 *    accounts:signUp → 200 con idToken anónimo) y el frontend ya espera la sesión
 *    (ensureAnonymousAuth con espera controlada) antes de tocar Firestore.
 *    ⇒ Las 5 colecciones operativas pasan a `isAuthenticated()`.
 *
 * ⚠ ORDEN DE DESPLIEGUE OBLIGATORIO:
 *  1. Desplegar PRIMERO el código de la app (este push ya lo hace vía Cloudflare Pages).
 *  2. DESPUÉS desplegar estas reglas (deploy_firebase del agente de infraestructura).
 *  Si se hacen en orden inverso, las terminales con la app vieja (sin espera de
 *  sesión) verían "Missing or insufficient permissions" hasta recargar.
 *
 * Endurecimiento definitivo (App Check con reCAPTCHA v3): ver AGENTS.md. Con App
 * Check en enforcement, las reglas pueden además exigir `request.auth != null &&
 * request.app`... vía verifyAppCheck() — se documenta pero NO se aplica hoy.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Perfiles de usuario: SOLO el dueño autenticado. (Antes: público total.)
    match /users/{userId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ===== Colecciones operativas del colegio (las únicas que usa la app) =====
    // Ronda 18: exigir sesión (anónima o de correo) — Anonymous ya está habilitado
    // y el frontend espera la sesión antes de leer/escribir (ensureAnonymousAuth).

    // Configuración institucional (doc 'main'; los secretos YA NO se suben — Ronda 16)
    match /school_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Estudiantes (carnés, fotos ya comprimidas client-side)
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Docentes
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Registros de asistencia
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Asignaciones docente-materia-bloque
    match /schedule_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ===== TODO LO DEMÁS: DENEGADO =====
    // Antes la catch-all permitía read/write público sobre cualquier colección
    // nueva o interna (y existía una /test pública). Firestore ya niega por
    // defecto; se declara explícito como política de mínima superficie.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
