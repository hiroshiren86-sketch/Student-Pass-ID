rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for user role validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // School configuration and settings
    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance records
    match /attendance_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Schedule assignments
    match /schedule_assignments/{assignmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Schedule slots
    match /schedule_slots/{slotId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom templates
    match /custom_templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }

    // Test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default rule for all documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

