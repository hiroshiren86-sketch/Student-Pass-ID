rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for user role validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ADMIN' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role == 'ADMIN' ||
        getUserData().role == 'DOCENTE'
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // School configuration and settings
    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || request.auth != null);
    }

    // Attendance records
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || request.auth != null);
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || request.auth != null);
    }

    // Default rule for other documents
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
