# ══════════════════════════════════════════════════════════════════════════
# R69 — Simulación E2E "Mini Colegio" · variables de entorno
# ══════════════════════════════════════════════════════════════════════════
# Copie este archivo a `.env` (MISMO directorio) y complete los valores.
# NUNCA commitee el `.env` real (Regla 9 de AGENTS.md). Si prefiere, exporte
# las variables en la shell o apunte E2E_ENV_FILE a su archivo actual
# (p. ej. /home/user/spv/.env, el que usaron las QA de R54-R58).
#
# Ejecutar:  bash tests/e2e/simulation/run_all.sh
#            node tests/e2e/simulation/01_regresion_filtro_y_escudito.mjs

# ── App bajo prueba ────────────────────────────────────────────────────────
BASE_URL=https://hiroshiren86-sketch.github.io/Student-Pass-ID/
# Para probar un build local:  BASE_URL=http://localhost:4173  (npx vite preview)

# ── Worker de Cloudflare (API de sincronización) ───────────────────────────
WORKER_URL=https://api-studentpassid.marcos78210.workers.dev
AUTH_TOKEN=
SCHOOL_CODE=INAS2026

# ── Credenciales REALES (propietario/QA) ───────────────────────────────────
# Rectoría: cuenta de Firebase ya existente (el sistema NO crea cuentas anónimas).
RECTORIA_EMAIL=
RECTORIA_PASS=

# Docente con cuenta de acceso (creada por Rectoría en R68 §25).
DOCENTE_EMAIL=
DOCENTE_PASS=

# Estudiante/representante para el paso B y C (código + clave de acceso).
ESTUDIANTE_CODE=
ESTUDIANTE_CLAVE=

# ── Ajustes de la corrida ──────────────────────────────────────────────────
HEADLESS=true
SLOWMO_MS=0
# Directorio de evidencia (capturas + reporte JSON). Vacío = tests/evidence/<timestamp>
EVIDENCE_DIR=
# Cursos que la corrida debe verificar (separados por coma). Vacío = todos los del catálogo.
E2E_GRADES=
